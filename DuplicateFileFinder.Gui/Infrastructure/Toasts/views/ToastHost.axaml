<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DuplicateFileFinder.Gui.Infrastructure.Toasts.Views.ToastHost"
    x:DataType="toasts:ToastHostViewModel"
    xmlns:toasts="clr-namespace:DuplicateFileFinder.Gui.Infrastructure.Toasts">

    <!-- Overlay in top-right -->
    <ItemsControl x:Name="ToastItems"
                  ItemsSource="{Binding Items}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="12"
                  IsHitTestVisible="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="toasts:ToastItemViewModel">
                <Border CornerRadius="10"
                        Padding="12"
                        MinWidth="260"
                        MaxWidth="520"
                        BoxShadow="0 6 18 0 #40000000"
                        IsHitTestVisible="False">

                    <!-- Use Tag to drive background via selectors -->
                    <Border Tag="{Binding Kind}">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="#2B2B2B"/>
                            </Style>
                            <Style Selector="Border[Tag=Info]">
                                <Setter Property="Background" Value="#2B2B2B"/>
                            </Style>
                            <Style Selector="Border[Tag=Success]">
                                <Setter Property="Background" Value="#1F3D2B"/>
                            </Style>
                            <Style Selector="Border[Tag=Warning]">
                                <Setter Property="Background" Value="#4A3A12"/>
                            </Style>
                            <Style Selector="Border[Tag=Error]">
                                <Setter Property="Background" Value="#4A1B1B"/>
                            </Style>
                        </Border.Styles>

                        <TextBlock Text="{Binding Message}"
                                   TextWrapping="Wrap"
                                   Foreground="White"/>
                    </Border>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
