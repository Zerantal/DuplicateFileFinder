<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  x:Class="DuplicateFileFinder.Gui.Features.Shell.Views.MainWindow"
  x:DataType="shellViews:MainWindowViewModel"
  Width="1000"
  Height="600"
  WindowState="Normal"
  Title="Duplicate File Finder"
  mc:Ignorable="mc"
  xmlns:shellViews="clr-namespace:DuplicateFileFinder.Gui.Features.Shell.ViewModels"
  xmlns:duplicatesViews="clr-namespace:DuplicateFileFinder.Gui.Features.Duplicates.Views"
  xmlns:toastViews="clr-namespace:DuplicateFileFinder.Gui.Infrastructure.Toasts.Views">

  <Grid>
    <!-- DockPanel; fills the remaining space -->
    <DockPanel Margin="8" LastChildFill="True">

      <!-- Menu bar at the top -->
      <Menu x:Name="MainMenu" DockPanel.Dock="Top">
        <MenuItem Header="_Debug"
                  IsVisible="{Binding IsDebugBuild}">
          <MenuItem Header="Dump repo trees (all)"
                    Command="{Binding DumpAllRepoTreesCommand}" />
          <MenuItem Header="Dump repo trees (live)"
                    Command="{Binding DumpLiveRepoTreesCommand}" />
        </MenuItem>
      </Menu>

      <!-- Simple toolbar row -->
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Spacing="8" Margin="0,6,0,6">
        <Button x:Name="ScanLocationButton"
                Content="Scan Location"
                Command="{Binding ScanLocationCommand}" />
      </StackPanel>

      <!-- Status area -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
        <!-- Metrics + operation -->
        <ItemsControl ItemsSource="{Binding StatusItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="16"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Key}" />
                <TextBlock Text=":" />
                <TextBlock Text="{Binding Value}" FontWeight="Bold"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <!-- Main content -->
      <duplicatesViews:DuplicatesView x:Name="DuplicatesView"
                                      DataContext="{Binding Duplicates}" />
    </DockPanel>

    <!-- Overlay: Toasts -->
    <toastViews:ToastHost x:Name="ToastHost"
                          DataContext="{Binding ToastHost}" />
  </Grid>
</Window>
