<!-- DuplicateFileFinder.Gui/Features/Duplicates/Views/ScanRoots/ScanRootsFlatTreeView.axaml -->
<!-- ReSharper disable InconsistentNaming -->
<UserControl
  x:Class="DuplicateFileFinder.Gui.Features.Duplicates.Views.ScanRoots.ScanRootsTreeView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:scanRoots="clr-namespace:DuplicateFileFinder.Gui.Features.Duplicates.Views.ScanRoots"
  xmlns:util="clr-namespace:DuplicateFileFinder.Gui.Infrastructure.Util"
  xmlns:scanRootsTree="clr-namespace:DuplicateFileFinder.Gui.Features.Duplicates.ViewModels.ScanRootsTree"
  xmlns:converters="clr-namespace:DuplicateFileFinder.Gui.Infrastructure.Converters"
  mc:Ignorable="d"
  x:DataType="scanRootsTree:IScanRootsTreeViewContext"
  d:DataContext="{x:Static scanRootsTree:ScanRootsTreeDesignData.Instance}"
  d:DesignWidth="980"
  d:DesignHeight="360">

  <UserControl.Resources>
    <!-- ReSharper disable once Xaml.RedundantResource -->
    <x:Double x:Key="ScanRootsScrollbarGutter">14</x:Double>
    <SolidColorBrush x:Key="ScanRootsSelectedRowBrush" Color="#663B82F6" />
    <SolidColorBrush x:Key="ScanRootsSelectedRowRailBrush" Color="#FF2D7DFF" />
    <SolidColorBrush x:Key="ScanRootsRowHoverBorderBrush" Color="#6683A8D8" />
    <SolidColorBrush x:Key="ScanRootsSelectedRowBorderBrush" Color="#FF4B86F8" />
    <SolidColorBrush x:Key="ScanRootsSelectedRowFocusBorderBrush" Color="#FF8CB8FF" />
    <SolidColorBrush x:Key="ScanRootsHeaderActiveBrush" Color="#443B82F6" />
    <SolidColorBrush x:Key="ScanRootsHeaderActiveBorderBrush" Color="#557EA6FF" />
    <SolidColorBrush x:Key="ScanRootsPercentTrackBrush" Color="#334A5568" />
    <SolidColorBrush x:Key="ScanRootsPercentFillBrush" Color="#FF1684E0" />
    <SolidColorBrush x:Key="ScanRootsPercentLabelBrush" Color="#EAF4FF" />
    <converters:ExpandedToGeometryConverter x:Key="ExpandedToGeometryConverter" />
    <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
    <converters:PercentToGridLengthConverter x:Key="PercentToGridLengthConverter" />

    <converters:SelectedRowBackgroundConverter x:Key="SelectedRowBackgroundConverter"
                                               SelectedBrush="{StaticResource ScanRootsSelectedRowBrush}"
                                               UnselectedBrush="Transparent" />
    <converters:SelectedRowBackgroundConverter x:Key="SelectedRowRailConverter"
                                               SelectedBrush="{StaticResource ScanRootsSelectedRowRailBrush}"
                                               UnselectedBrush="Transparent" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Debug outlining -->
    <Styles>
      <Style Selector="Border.debug-outline">
        <Setter Property="BorderBrush" Value="#80FF0000" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>

      <Style Selector="Button.debug-outline">
        <Setter Property="BorderBrush" Value="Orange" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>

      <Style Selector="Grid.debug-outline">
        <Setter Property="ShowGridLines" Value="True" />
      </Style>
    </Styles>
    <!-- ==================== -->

    <Style Selector="Border.scanroots-row">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="2,1" />
      <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style Selector="Button.scanroot-header:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeControlLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
    </Style>

    <Style Selector="Button.scanroot-header:pressed">
      <Setter Property="Background" Value="{StaticResource ScanRootsHeaderActiveBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ScanRootsHeaderActiveBorderBrush}" />
    </Style>

    <Style Selector="Button.scanroot-header:disabled">
      <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style Selector="Button.scanroot-header">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontWeight" Value="SemiBold" />

      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Grid ColumnDefinitions="*,Auto"
                  Margin="8,6,12,6">

              <TextBlock
                Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(scanRoots:HeaderButton.Text)}"
                VerticalAlignment="Center"
                TextAlignment="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(scanRoots:HeaderButton.TextAlignment)}"
                Foreground="{TemplateBinding Foreground}" />

              <TextBlock Grid.Column="1"
                         Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(scanRoots:HeaderButton.Arrow)}"
                         Margin="6,0,0,0"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="11"
                         Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.scanroot-header.active-sort">
      <Setter Property="Background" Value="{StaticResource ScanRootsHeaderActiveBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ScanRootsHeaderActiveBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.scanroot-header.passive-header">
      <Setter Property="Opacity" Value="0.78" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.scanroots-expander">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.scanroots-expander:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeControlLowBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.scanroots-expander:pressed">
      <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBlock.scanroots-number">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="monospace" />
      <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style Selector="Border.scanroots-number-cell">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <Style Selector="TextBlock.scanroots-name">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="monospace" />
      <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style Selector="Border.scanroots-percent-track">
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{StaticResource ScanRootsPercentTrackBrush}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.scanroots-percent-fill">
      <Setter Property="Background" Value="{StaticResource ScanRootsPercentFillBrush}" />
    </Style>

    <Style Selector="TextBlock.scanroots-percent-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="Border.scanroots-row:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource ScanRootsRowHoverBorderBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.scanroots-row.selected">
      <Setter Property="BorderBrush" Value="{StaticResource ScanRootsSelectedRowBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.scanroots-row.selected:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource ScanRootsSelectedRowFocusBorderBrush}" />
    </Style>

    <Style Selector="Border.scanroots-row:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHighBrush}" />
    </Style>

    <Style Selector="Border.scanroots-row.selected:focus">
      <Setter Property="BorderBrush" Value="{StaticResource ScanRootsSelectedRowFocusBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

  </UserControl.Styles>

  <DockPanel>

    <!-- Header (same grid/columns as original) -->
    <Border DockPanel.Dock="Top"
            x:Name="PART_HeaderHost"
            Background="{DynamicResource ThemeControlMidBrush}"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="0,0,0,1"
            Padding="6,5">
      <Grid x:DataType="scanRootsTree:IScanRootsTreeViewContext"
            ColumnDefinitions="2*,200,110,110,110,110,110">

        <Button Grid.Column="0"
                Classes="scanroot-header"
                Classes.active-sort="{Binding SortColumn, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Name}"
                scanRoots:HeaderButton.Text="Name"
                scanRoots:HeaderButton.Arrow="{Binding NameArrow}"
                scanRoots:HeaderButton.TextAlignment="Left"
                Command="{Binding SortByCommand}"
                CommandParameter="{x:Static scanRootsTree:ScanRootsSortColumn.Name}" />

        <Button Grid.Column="1"
                Classes="scanroot-header passive-header"
                scanRoots:HeaderButton.Text="Subtree %"
                scanRoots:HeaderButton.TextAlignment="Center"
                IsHitTestVisible="False"
                MinWidth="100"
                MaxWidth="400" />

        <Button Grid.Column="2"
                Classes="scanroot-header"
                Classes.active-sort="{Binding SortColumn, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Size}"
                scanRoots:HeaderButton.Text="Size"
                scanRoots:HeaderButton.Arrow="{Binding SizeArrow}"
                scanRoots:HeaderButton.TextAlignment="Right"
                Command="{Binding SortByCommand}"
                CommandParameter="{x:Static scanRootsTree:ScanRootsSortColumn.Size}" />

        <Button Grid.Column="3"
                Classes="scanroot-header"
                Classes.active-sort="{Binding SortColumn, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Items}"
                scanRoots:HeaderButton.Text="Items"
                scanRoots:HeaderButton.Arrow="{Binding ItemsArrow}"
                scanRoots:HeaderButton.TextAlignment="Right"
                Command="{Binding SortByCommand}"
                CommandParameter="{x:Static scanRootsTree:ScanRootsSortColumn.Items}" />

        <Button Grid.Column="4"
                Classes="scanroot-header"
                Classes.active-sort="{Binding SortColumn, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Files}"
                scanRoots:HeaderButton.Text="Files"
                scanRoots:HeaderButton.Arrow="{Binding FilesArrow}"
                scanRoots:HeaderButton.TextAlignment="Right"
                Command="{Binding SortByCommand}"
                CommandParameter="{x:Static scanRootsTree:ScanRootsSortColumn.Files}" />

        <Button Grid.Column="5"
                Classes="scanroot-header"
                Classes.active-sort="{Binding SortColumn, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=DupFiles}"
                scanRoots:HeaderButton.Text="Dup Files"
                scanRoots:HeaderButton.Arrow="{Binding DupFilesArrow}"
                scanRoots:HeaderButton.TextAlignment="Right"
                Command="{Binding SortByCommand}"
                CommandParameter="{x:Static scanRootsTree:ScanRootsSortColumn.DupFiles}" />

        <Button Grid.Column="6"
                Classes="scanroot-header"
                Classes.active-sort="{Binding SortColumn, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=DupBytes}"
                scanRoots:HeaderButton.Text="Dup Size"
                scanRoots:HeaderButton.Arrow="{Binding DupBytesArrow}"
                scanRoots:HeaderButton.TextAlignment="Right"
                Command="{Binding SortByCommand}"
                CommandParameter="{x:Static scanRootsTree:ScanRootsSortColumn.DupBytes}" />

      </Grid>
    </Border>
    <Grid>
      <!-- Virtualized "tree" -->
      <ScrollViewer x:Name="PART_Scroller"
                    IsVisible="{Binding HasRows}">
        <Border x:Name="PART_RowsHost">
          <ItemsRepeater x:Name="PART_Repeater"
                         ItemsSource="{Binding Rows}">
            <ItemsRepeater.Layout>
              <!-- default vertical stack; ItemsRepeater provides virtualization -->
              <StackLayout Orientation="Vertical" />
            </ItemsRepeater.Layout>

            <!-- Delete key binding (same semantics as TreeView version) -->
            <ItemsRepeater.KeyBindings>
              <KeyBinding Gesture="Delete"
                          Command="{Binding SelectedRow.DeleteFromDiskCommand,
                                      FallbackValue={x:Static util:Commands.DisabledCommand}}" />
            </ItemsRepeater.KeyBindings>

            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="scanRootsTree:ScanRootsRowViewModel">

            <!-- Row wrapper -->
            <Border Classes="scanroots-row"
                    Margin="0,0,0,0"
                    Padding="0"
                    Focusable="True"
                    PointerPressed="Row_OnPointerPressed">
              <Border.Background>
                <MultiBinding Converter="{StaticResource SelectedRowBackgroundConverter}">
                  <Binding /> <!-- the row VM -->
                  <Binding
                    Path="$parent[UserControl].((scanRootsTree:IScanRootsTreeViewContext)DataContext).SelectedRow" />
                </MultiBinding>
              </Border.Background>
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy path"
                            Command="{Binding CopyPathCommand}" />
                  <MenuItem Header="{Binding RescanOrResumeHeader}"
                            Command="{Binding RescanLocationCommand}"
                            IsVisible="{Binding IsScanRoot}" />
                  <MenuItem Header="Rescan folder"
                            Command="{Binding RescanFolderCommand}"
                            IsVisible="{Binding !IsScanRoot }" />
                  <MenuItem Header="Delete from disk"
                            Command="{Binding DeleteFromDiskCommand}"
                            IsVisible="{Binding CanDeleteFromDisk}" />
                  <MenuItem Header="Remove location"
                            Command="{Binding RemoveLocationCommand}"
                            IsVisible="{Binding IsScanRoot}" />
                  <MenuItem Header="Set display name"
                            Command="{Binding SetDisplayNameCommand}"
                            IsVisible="{Binding IsScanRoot}" />
                </ContextMenu>
              </Border.ContextMenu>

              <Grid ColumnDefinitions="2*,200,110,110,110,110,110"
                    Margin="4,0,4,0"
                    VerticalAlignment="Center"
                    Background="Transparent">

                <!-- Name column: indent + expander glyph + text -->
                <Grid Grid.Column="0"
                      ColumnDefinitions="3,*">
                  <Border Grid.Column="0">
                    <Border.Background>
                      <MultiBinding Converter="{StaticResource SelectedRowRailConverter}">
                        <Binding />
                        <Binding Path="$parent[UserControl].((scanRootsTree:IScanRootsTreeViewContext)DataContext).SelectedRow" />
                      </MultiBinding>
                    </Border.Background>
                  </Border>

                  <Grid Grid.Column="1"
                        ColumnDefinitions="Auto,24,*"
                        VerticalAlignment="Center">

                    <!-- Indent: depth provided by converter -->
                    <Border Grid.Column="0"
                            Width="{Binding Depth, Converter={StaticResource DepthToIndentWidthConverter}}" />

                    <!-- Expander button -->
                    <Button Grid.Column="1"
                            Classes="scanroots-expander"
                            IsVisible="{Binding HasLazyChildren}"
                            Command="{Binding $parent[UserControl].((scanRootsTree:IScanRootsTreeViewContext)DataContext).ToggleExpandedCommand}"
                            CommandParameter="{Binding}">
                      <Path Width="10"
                            Height="10"
                            Data="{Binding IsExpanded, Converter={StaticResource ExpandedToGeometryConverter}}"
                            Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                            StrokeThickness="1.6"
                            StrokeLineCap="Round"
                            StrokeJoin="Round" />
                    </Button>

                    <!-- Name -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayName}"
                               Classes="scanroots-name"
                               TextTrimming="CharacterEllipsis"
                               />
                  </Grid>
                </Grid>

                <!-- Subtree % -->
                <Grid Grid.Column="1"
                      VerticalAlignment="Center"
                      MinWidth="100"
                      MaxWidth="400">
                  <Border Classes="scanroots-percent-track"
                          Margin="3,0,3,0">
                    <Grid>
                      <Grid Classes="scanroots-percent-track">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding PercentOfScanRoot, Converter={StaticResource PercentToGridLengthConverter}}" />
                          <ColumnDefinition Width="{Binding PercentOfScanRoot, Converter={StaticResource PercentToGridLengthConverter}, ConverterParameter=remaining}" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Classes="scanroots-percent-fill" />
                      </Grid>

                      <TextBlock Text="{Binding PercentOfScanRoot, StringFormat={}{0:F1}%}"
                                 Classes="scanroots-percent-label"
                                 HorizontalAlignment="Left" />
                    </Grid>
                  </Border>
                </Grid>

                <!-- Size -->
                <Border Grid.Column="2"
                        Classes="scanroots-number-cell"
                        Padding="8,0,0,0">
                  <TextBlock Classes="scanroots-number"
                             Text="{Binding TotalBytes, Converter={StaticResource BytesToHuman}}" />
                </Border>

                <!-- Items -->
                <Border Grid.Column="3"
                        Classes="scanroots-number-cell"
                        Padding="8,0,0,0">
                  <TextBlock Classes="scanroots-number"
                             Text="{Binding ItemCount, StringFormat={}{0:N0}}" />
                </Border>

                <!-- Files -->
                <Border Grid.Column="4"
                        Classes="scanroots-number-cell"
                        Padding="8,0,0,0">
                  <TextBlock Classes="scanroots-number"
                             Text="{Binding FileCount, StringFormat={}{0:N0}}" />
                </Border>

                <!-- Dup Files -->
                <Border Grid.Column="5"
                        Classes="scanroots-number-cell"
                        Padding="8,0,0,0">
                  <TextBlock Classes="scanroots-number"
                             Text="{Binding DuplicateFiles, StringFormat={}{0:N0}}" />
                </Border>

                <!-- Dup Bytes -->
                <Border Grid.Column="6"
                        Classes="scanroots-number-cell"
                        Padding="8,0,0,0">
                  <TextBlock Classes="scanroots-number"
                             Text="{Binding DuplicateBytes, Converter={StaticResource BytesToHuman}}" />
                </Border>

              </Grid>
            </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </Border>
      </ScrollViewer>

      <!-- ReSharper disable once InconsistentNaming -->
      <Border x:Name="PART_EmptyState"
              IsVisible="{Binding !HasRows}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="14,10"
              Background="{DynamicResource ThemeControlLowBrush}"
              BorderBrush="{DynamicResource ThemeBorderMidBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <StackPanel Spacing="4">
          <TextBlock Text="No scan roots to display"
                     HorizontalAlignment="Center"
                     FontWeight="SemiBold" />
          <TextBlock Text="Add a location or run a scan to populate this view."
                     HorizontalAlignment="Center"
                     Opacity="0.85" />
        </StackPanel>
      </Border>
    </Grid>

  </DockPanel>
</UserControl>
