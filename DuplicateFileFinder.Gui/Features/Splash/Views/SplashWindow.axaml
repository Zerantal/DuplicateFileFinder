<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:DuplicateFileFinder.Gui.Features.Splash.ViewModels"
        x:Class="DuplicateFileFinder.Gui.Features.Splash.Views.SplashWindow"
        Width="420" Height="260"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="BorderOnly"
        x:DataType="viewModels:SplashViewModel"
        Title="Duplicate File Finder">
    <Border Padding="24">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <TextBlock x:Name="TitleText"
                       Text="Duplicate File Finder"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="MessageText"
                       Text="{Binding Message}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,8,0,0" />
            <ProgressBar x:Name="LoadingBar"
                         IsIndeterminate="True"
                         Width="220"
                         Margin="0,16,0,0" />
            <TextBlock x:Name="SubMessageText"
                       Text="{Binding SubMessage}"
                       FontSize="11"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="320" />
        </StackPanel>
    </Border>
</Window>
