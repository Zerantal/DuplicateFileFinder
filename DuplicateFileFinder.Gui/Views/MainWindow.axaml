<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DuplicateFileFinder.Gui.ViewModels"
    xmlns:dgrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    x:Class="DuplicateFileFinder.Gui.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Width="1000"
    Height="600"
    WindowState="Normal"
    Title="Duplicate File Finder"
    mc:Ignorable="mc"
    xmlns:models="using:DuplicateFileFinder.Gui.Models"
    xmlns:views="clr-namespace:DuplicateFileFinder.Gui.Views">

    <Window.Resources>

        <!-- Cell templates -->
        <DataTemplate x:Key="CellFileName" x:DataType="models:DuplicateFileModel">
            <TextBlock Text="{Binding FileName}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       ToolTip.Tip="{Binding FileName}" />
        </DataTemplate>

        <DataTemplate x:Key="CellFileSize" x:DataType="models:DuplicateFileModel">
            <TextBlock TextAlignment="Right"
                       HorizontalAlignment="Right"
                       Text="{Binding FileSize, Converter={StaticResource BytesToHuman}}" />
        </DataTemplate>

        <DataTemplate x:Key="CellCreationDate" x:DataType="models:DuplicateFileModel">
            <TextBlock Text="{Binding CreationDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"
                       TextWrapping="NoWrap" />
        </DataTemplate>

        <DataTemplate x:Key="CellFileGroup" x:DataType="models:DuplicateFileModel">
            <TextBlock Text="{Binding FileGroup}"
                       TextAlignment="Right" />
        </DataTemplate>
    </Window.Resources>
    
    <!-- ONE root: DockPanel; last child fills the remaining space -->
    <DockPanel Margin="8" LastChildFill="True">

        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New"
                          Command="{Binding NewScanCommand}" />
                <MenuItem Header="_Open..."
                          Command="{Binding OpenScanCommand}" />
                <MenuItem Header="_Save..."
                          Command="{Binding SaveScanCommand}" />
                <Separator />
                <!-- <MenuItem Header="E_xit" IsEnabled="True" /> -->
            </MenuItem>
        </Menu>

        <!-- Simple toolbar row -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Spacing="8" Margin="0,6,0,6">
            <Button Content="Scan Location" Command="{Binding ScanLocationCommand}" />
            <Button Content="Stop" Command="{Binding StopScanCommand}" />
            <Separator />
            <Button Content="New" Command="{Binding NewScanCommand}" />
            <Button Content="Open" Command="{Binding OpenScanCommand}" />
            <Button Content="Save" Command="{Binding SaveScanCommand}" />
        </StackPanel>

        <!-- Status area -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
            <!-- Progress -->
            <ProgressBar Grid.Row="0" Grid.ColumnSpan="2"
                         Minimum="0" Maximum="100"
                         Height="8"
                         IsIndeterminate="{Binding IsIndeterminateProgressPhase}"
                         Value="{Binding ScanProgress}" />
            <!-- Metrics + operation -->
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                <TextBlock Text="Files scanned:" />
                <TextBlock Text="{Binding FilesScanned, StringFormat='{}{0:N0}'}" />

                <TextBlock Text="Duplicates:" Margin="12,0,0,0" />
                <TextBlock Text="{Binding DuplicatesFound, StringFormat='{}{0:N0}'}" />

                <TextBlock Text="Space wasted:" Margin="12,0,0,0" />
                <TextBlock Text="{Binding SpaceTaken, Converter={StaticResource BytesToHuman}}" />
            </StackPanel>
            <!-- Operation (right, fills remaining width) -->
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Margin="80,6,0,0"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       TextAlignment="Left"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Operation}"
                       ToolTip.Tip="{Binding Operation}" />
            <!-- <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Operation}" Margin="12,6,0,0" /> -->
        </Grid>

        <!-- Main content -->
        <views:DuplicatesGrid DataContext="{Binding Duplicates}"/>
        
