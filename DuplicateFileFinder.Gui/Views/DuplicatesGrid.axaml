<!-- Views/DuplicatesGrid.axaml -->
<UserControl
  x:Class="DuplicateFileFinder.Gui.Views.DuplicatesGrid"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:dgrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
  xmlns:vm="using:DuplicateFileFinder.Gui.ViewModels"
  xmlns:models="clr-namespace:DuplicateFileFinder.Gui.Models"
  x:DataType="vm:DuplicatesGridViewModel">

  <Grid RowDefinitions="Auto,*">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,6">
      <TextBlock Text="Duplicate sets:"/>
      <TextBlock Text="{Binding TotalSets}"/>
      <TextBlock Text="Files:" Margin="12,0,0,0"/>
      <TextBlock Text="{Binding TotalFiles}"/>
    </StackPanel>

    <dgrid:DataGrid Grid.Row="1"
                    x:Name="PartGrid"
                    ItemsSource="{Binding Rows}"
                    IsReadOnly="True"
                    RowDetailsVisibilityMode="VisibleWhenSelected"
                    SelectionMode="Single">
      <dgrid:DataGrid.Columns>
        <!-- First element’s name -->
        <dgrid:DataGridTextColumn Header="Name"
                                  Binding="{Binding RepresentativeName}"
                                  Width="2*"/>
        <!-- Count and total size -->
        <dgrid:DataGridTextColumn Header="Files"
                                  Binding="{Binding Count}"
                                  Width="80"/>
        <dgrid:DataGridTextColumn Header="Total Size"
                                  Binding="{Binding TotalBytes}"
                                  Width="140"/>
      </dgrid:DataGrid.Columns>

      <dgrid:DataGrid.RowDetailsTemplate>
        <DataTemplate x:DataType="models:DuplicateSetRow">
          <dgrid:DataGrid ItemsSource="{Binding Items}"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
            <dgrid:DataGrid.Columns>
              <dgrid:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
              <!-- Full path -->
              <dgrid:DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*"/>
              <dgrid:DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="120"/>
              <dgrid:DataGridTextColumn Header="Modified"
                                        Binding="{Binding Modified, StringFormat=G}"
                                        Width="160"/>
            </dgrid:DataGrid.Columns>
          </dgrid:DataGrid>
        </DataTemplate>
      </dgrid:DataGrid.RowDetailsTemplate>
    </dgrid:DataGrid>
  </Grid>
</UserControl>
