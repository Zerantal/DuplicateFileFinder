<!-- Views/DuplicatesView.axaml -->
<UserControl
    x:Class="DuplicateFileFinder.Gui.Views.DuplicatesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dgrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    xmlns:vm="using:DuplicateFileFinder.Gui.ViewModels"
    x:DataType="vm:DuplicatesViewModel"
    mc:Ignorable="d">

   <UserControl.Styles>
       <StyleInclude Source="DuplicatesViewStyles.axaml"></StyleInclude>
   </UserControl.Styles>

    <!-- Row0: filters; Row1/2: tree + grids -->
  <Grid RowDefinitions="Auto,2*,*"
        ColumnDefinitions="2*,5*">

    <!-- Filters / controls (span both columns) -->
        <StackPanel Grid.Row="0"
                Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,0,0,6">

            <TextBlock Text="Window size:" Margin="16,0,0,0" VerticalAlignment="Center" />
            <NumericUpDown Minimum="50"
                           Maximum="5000"
                           Increment="50"
                           Value="{Binding WindowSize}" />

            <Button Content="Load more"
                    Margin="16,0,0,0"
                    IsEnabled="{Binding CanLoadMore}"
                    Click="OnLoadMoreClick" />
        </StackPanel>

    <!-- LEFT: folder tree, spans both grids vertically -->
    <TreeView Grid.Row="1"
              Grid.RowSpan="2"
              Grid.Column="0"
              ItemsSource="{Binding FolderRoots}"
              SelectionChanged="OnFolderSelected"
              SelectionMode="Single">
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="vm:FolderNodeViewModel"
                                  ItemsSource="{Binding Children}">
          <TextBlock Text="{Binding Name}"/>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <!-- RIGHT (top): duplicate sets -->
        <dgrid:DataGrid Grid.Row="1"
                    Grid.Column="1"
                        ItemsSource="{Binding VisibleRows}"
                        SelectedItem="{Binding SelectedSet, Mode=TwoWay}"
                        VerticalScroll="DataGrid_OnVerticalScroll"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        HeadersVisibility="Column">
            <dgrid:DataGrid.Columns>
                <dgrid:DataGridTextColumn Header="Name"
                                          Binding="{Binding RepresentativeName}"
                                          Width="2*"/>
                <dgrid:DataGridTextColumn Header="Files"
                                          Binding="{Binding Count}"
                                          Width="80" />
                <dgrid:DataGridTextColumn Header="Total Size"
                                          Binding="{Binding TotalBytes, Converter={StaticResource BytesToHuman}}"
                                          Width="140" />
            </dgrid:DataGrid.Columns>
        </dgrid:DataGrid>

    <!-- RIGHT (bottom): files in selected set -->
        <dgrid:DataGrid Grid.Row="2"
                    Grid.Column="1"
                        ItemsSource="{Binding SelectedItems}"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        HeadersVisibility="Column"
                        Margin="0,6,0,0">
            <dgrid:DataGrid.Columns>
                <dgrid:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <dgrid:DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*" />
                <dgrid:DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="120" />
                <dgrid:DataGridTextColumn Header="Modified"
                                          Binding="{Binding Modified, StringFormat=G}"
                                          Width="160" />
            </dgrid:DataGrid.Columns>
        </dgrid:DataGrid>

    </Grid>
</UserControl>
