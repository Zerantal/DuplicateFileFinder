<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">
    <targets>
        <target xsi:type="Console" name="console"
                layout="${longdate}|${level:uppercase=true}|${logger}|${message}" />
        <target xsi:type="File" name="perf"
                fileName="${basedir}/logs/perf.log"
                layout="${longdate}|${level:uppercase=true}|${logger}|${message}" />
    </targets>

    <rules>
        <!-- Show only timing/perf on console -->
        <logger name="DuplicateFileFinderLib.Logging.TimingLog" minlevel="Info" writeTo="console" final="true" />
        <!-- Optional: also persist to file -->
        <logger name="DuplicateFileFinderLib.Logging.TimingLog" minlevel="Info" writeTo="perf" />
        <!-- If you want the "Started ..." DEBUG lines too, change minlevel to Debug -->
    </rules>
</nlog>